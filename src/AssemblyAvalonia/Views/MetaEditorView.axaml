<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:meta="clr-namespace:AssemblyAvalonia.Models.MetaData"
             x:Class="AssemblyAvalonia.Views.MetaEditorView">

  <UserControl.Resources>
    <SolidColorBrush x:Key="FieldLabelBrush" Color="#FF989898" />
    <SolidColorBrush x:Key="FieldValueBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FieldTypeBrush" Color="#FF6A9955" />
    <SolidColorBrush x:Key="BlockHeaderBrush" Color="#FF0079CB" />
  </UserControl.Resources>

  <!-- DataTemplates at UserControl level so nested ContentPresenters (inside WrappedTagBlockEntry) can find them -->
  <UserControl.DataTemplates>

    <!-- Comment -->
    <DataTemplate DataType="meta:CommentData">
      <Border Background="#FF1E1E1E" CornerRadius="3" Padding="8,4" Margin="0,2">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                     Foreground="{StaticResource BlockHeaderBrush}" />
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"
                     Foreground="{StaticResource FieldLabelBrush}"
                     IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Numeric fields: editable TextBox with TwoWay binding -->
    <DataTemplate DataType="meta:Uint8Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="uint8" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Int8Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="int8" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Uint16Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="uint16" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Int16Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="int16" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Uint32Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="uint32" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Int32Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="int32" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Uint64Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="uint64" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Int64Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="int64" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="meta:Float32Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="float32" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- StringID: editable -->
    <DataTemplate DataType="meta:StringIDData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="stringid" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- OldStringIDData -->
    <DataTemplate DataType="meta:OldStringIDData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="oldstringid" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- String: editable -->
    <DataTemplate DataType="meta:StringData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="string" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Tag Reference -->
    <DataTemplate DataType="meta:TagRefData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding Group.TagGroupMagic}" Foreground="{StaticResource BlockHeaderBrush}" />
          <TextBlock Text="{Binding Value.TagFileName}" Foreground="{StaticResource FieldValueBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="tagref" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
      </Grid>
    </DataTemplate>

    <!-- Flags: checkboxes for each bit -->
    <DataTemplate DataType="meta:FlagData">
      <StackPanel Margin="0,2">
        <Grid ColumnDefinitions="200,*,80">
          <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='0x{0:X}'}"
                     Foreground="{StaticResource FieldValueBrush}" FontSize="11" />
          <TextBlock Grid.Column="2" Text="{Binding TypeStr}" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Bits}" Margin="200,2,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsSet, Mode=TwoWay}"
                        Content="{Binding Name}" Margin="0,0,12,0"
                        FontSize="11" Foreground="{StaticResource FieldValueBrush}"
                        ToolTip.Tip="{Binding ToolTip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Enum: ComboBox for selection -->
    <DataTemplate DataType="meta:EnumData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Values}"
                  SelectedItem="{Binding SelectedValue, Mode=TwoWay}"
                  Padding="4,2" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding ToolTip}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="2" Text="{Binding TypeStr}" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Color -->
    <DataTemplate DataType="meta:ColorData">
      <Grid ColumnDefinitions="200,Auto,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
        <Border Grid.Column="1" Width="20" Height="16" CornerRadius="2" Margin="0,0,8,0">
          <Border.Background>
            <SolidColorBrush Color="{Binding Value}" />
          </Border.Background>
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{StaticResource FieldValueBrush}" />
        <TextBlock Grid.Column="3" Text="color" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
      </Grid>
    </DataTemplate>

    <!-- Vector2 -->
    <DataTemplate DataType="meta:Vector2Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="vector2" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Vector3 -->
    <DataTemplate DataType="meta:Vector3Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding C, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="vector3" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Vector4 -->
    <DataTemplate DataType="meta:Vector4Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding C, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding D, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="vector4" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Degree -->
    <DataTemplate DataType="meta:DegreeData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" />
        <TextBlock Grid.Column="2" Text="degree" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Degree2 -->
    <DataTemplate DataType="meta:Degree2Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="degree2" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Point2 -->
    <DataTemplate DataType="meta:Point2Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="point2" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Point16 -->
    <DataTemplate DataType="meta:Point16Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="point16" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Degree3 -->
    <DataTemplate DataType="meta:Degree3Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding C, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="degree3" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Point3 -->
    <DataTemplate DataType="meta:Point3Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding C, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="point3" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Plane2 -->
    <DataTemplate DataType="meta:Plane2Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBox Text="{Binding C, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="plane2" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Plane3 -->
    <DataTemplate DataType="meta:Plane3Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding B, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding C, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding D, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="70" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="plane3" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Rectangle -->
    <DataTemplate DataType="meta:RectangleData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding B, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding C, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding D, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="rect" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Quaternion16 -->
    <DataTemplate DataType="meta:Quaternion16Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBox Text="{Binding A, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding B, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding C, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
          <TextBox Text="{Binding D, Mode=TwoWay}" Padding="4,2" MinWidth="70" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="quat16" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Range Int16 -->
    <DataTemplate DataType="meta:RangeInt16Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Min:" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
          <TextBox Text="{Binding Min, Mode=TwoWay}" Padding="4,2" MinWidth="80" />
          <TextBlock Text="Max:" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
          <TextBox Text="{Binding Max, Mode=TwoWay}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="rangeint16" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Range Float32 -->
    <DataTemplate DataType="meta:RangeFloat32Data">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Min:" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
          <TextBox Text="{Binding Min, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBlock Text="Max:" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
          <TextBox Text="{Binding Max, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="rangef32" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Range Degree -->
    <DataTemplate DataType="meta:RangeDegreeData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Min:" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
          <TextBox Text="{Binding Min, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
          <TextBlock Text="Max:" Foreground="{StaticResource FieldLabelBrush}" VerticalAlignment="Center" />
          <TextBox Text="{Binding Max, Mode=TwoWay, StringFormat='{}{0:F4}'}" Padding="4,2" MinWidth="80" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="rangedeg" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- TagBlock (Reflexive) -->
    <DataTemplate DataType="meta:TagBlockData">
      <Border Background="#FF1E1E1E" CornerRadius="3" Padding="6,4" Margin="0,3">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}"
                        IsEnabled="{Binding HasChildren}"
                        Padding="4,2" MinWidth="0" Background="Transparent">
            <Panel>
              <TextBlock Text="&#x25B6;" IsVisible="{Binding !IsExpanded}" FontSize="10" />
              <TextBlock Text="&#x25BC;" IsVisible="{Binding IsExpanded}" FontSize="10" />
            </Panel>
          </ToggleButton>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center" Margin="4,0">
            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                       Foreground="{StaticResource BlockHeaderBrush}" />
            <TextBlock Text="{Binding Length, StringFormat='[{0} elements]'}"
                       Foreground="{StaticResource FieldLabelBrush}" FontSize="11"
                       VerticalAlignment="Center" />
          </StackPanel>
          <ComboBox Grid.Column="2" ItemsSource="{Binding Pages}"
                    SelectedIndex="{Binding CurrentIndex}"
                    IsVisible="{Binding HasChildren}" MinWidth="80" Padding="4,2">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Index, StringFormat='Page {0}'}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- WrappedTagBlockEntry -->
    <DataTemplate DataType="meta:WrappedTagBlockEntry">
      <Border Margin="20,0,0,0" BorderBrush="#FF3F3F46" BorderThickness="1,0,0,0" Padding="8,0,0,0">
        <ContentPresenter Content="{Binding WrappedField}" />
      </Border>
    </DataTemplate>

    <!-- ShaderRef -->
    <DataTemplate DataType="meta:ShaderRef">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding Type}" Foreground="{StaticResource BlockHeaderBrush}" />
          <TextBlock Text="{Binding DatabasePath}" Foreground="{StaticResource FieldValueBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="shader" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
      </Grid>
    </DataTemplate>

    <!-- DataRef -->
    <DataTemplate DataType="meta:DataRef">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat='({0} bytes)'}" Foreground="{StaticResource FieldValueBrush}" />
        <TextBlock Grid.Column="2" Text="dataref" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
      </Grid>
    </DataTemplate>

    <!-- RawData -->
    <DataTemplate DataType="meta:RawData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
        <TextBlock Grid.Column="1" Text="{Binding Length, StringFormat='({0} bytes)'}" Foreground="{StaticResource FieldValueBrush}" />
        <TextBlock Grid.Column="2" Text="raw" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
      </Grid>
    </DataTemplate>

    <!-- Datum -->
    <DataTemplate DataType="meta:DatumData">
      <Grid ColumnDefinitions="200,*,80" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource FieldLabelBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Salt, StringFormat='Salt: {0}'}" Foreground="{StaticResource FieldValueBrush}" />
          <TextBlock Text="{Binding Index, StringFormat='Index: {0}'}" Foreground="{StaticResource FieldValueBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="datum" Foreground="{StaticResource FieldTypeBrush}" FontSize="11" />
      </Grid>
    </DataTemplate>

  </UserControl.DataTemplates>

  <DockPanel>

    <!-- Tag header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}"
            Padding="8" Margin="0,0,0,2">
      <TextBlock x:Name="TagHeader" FontSize="14" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- Plugin info -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}"
            Padding="8,4" Margin="0,0,0,4">
      <TextBlock x:Name="PluginInfo" FontSize="11"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </Border>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SaveButton" Content="Save" Click="Save_Click"
                IsVisible="False" Padding="12,4" />
      </StackPanel>
    </Border>

    <!-- Scrollable field list -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="FieldList" Margin="4" />
    </ScrollViewer>
  </DockPanel>

</UserControl>
