<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssemblyAvalonia.Views.AboutWindow"
        Title="About Assembly"
        Width="480" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E">

  <StackPanel Margin="30,24,30,20">

    <!-- Title -->
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
               Foreground="#FFFFFFFF" Margin="0,0,0,4" />
    <TextBlock Text="Cross-platform Halo cache file editor"
               Foreground="#FF999999" FontSize="13" Margin="0,0,0,16" />

    <Separator Background="#FF444444" Margin="0,0,0,16" />

    <!-- Description -->
    <TextBlock TextWrapping="Wrap" Foreground="#FFBBBBBB" FontSize="13" Margin="0,0,0,16">
      Assembly is an application for research and modification of Blam engine
      cache files, originally created by the Xbox Chaos community. This cross-platform
      port uses Avalonia UI and runs on Windows, Linux, and macOS.
    </TextBlock>

    <!-- Cross-Platform Port -->
    <TextBlock Text="Cross-Platform Port" FontSize="15" FontWeight="SemiBold"
               Foreground="#FF0078D7" Margin="0,0,0,6" />
    <TextBlock Text="    Jestzer" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,0,14" />

    <!-- Original R&D -->
    <TextBlock Text="Original Research and Development" FontSize="15" FontWeight="SemiBold"
               Foreground="#FF0078D7" Margin="0,0,0,6" />
    <WrapPanel Margin="16,0,0,14">
      <TextBlock Text="AMD" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="0xdeafcafe" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="DeadCanadian" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Thunder" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Gabe_k" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Lord Zedd" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="SnipeStyle" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="OrangeMohawk" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Dragonflare921" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
    </WrapPanel>

    <!-- Special Thanks -->
    <TextBlock Text="Special Thanks" FontSize="15" FontWeight="SemiBold"
               Foreground="#FF0078D7" Margin="0,0,0,6" />
    <WrapPanel Margin="16,0,0,14">
      <TextBlock Text="Xenomega" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Kornman00" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="CLK" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="DarkShallFall" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Prey" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Shade45" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Anthony" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="KingDingDan" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="XenonDev" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Gravemind" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
      <TextBlock Text="Farklem" Foreground="#FFCCCCCC" FontSize="13" Margin="0,0,16,2" />
    </WrapPanel>

    <Separator Background="#FF444444" Margin="0,2,0,12" />

    <!-- License -->
    <TextBlock Text="Licensed under GPL-3.0" Foreground="#FF777777" FontSize="12" Margin="0,0,0,16" />

    <!-- OK Button -->
    <Button Content="OK" HorizontalAlignment="Right" Padding="24,6"
            Click="OK_Click" />

  </StackPanel>

</Window>
