<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AssemblyAvalonia.Views.BitmapPreviewView">

  <DockPanel>

    <!-- Tag header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}"
            Padding="8" Margin="0,0,0,2">
      <TextBlock x:Name="TagHeader" FontSize="14" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- Bitmap selector and info -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}"
            Padding="8,4" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Bitmap:" Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="BitmapSelector" Width="280" Padding="4,2"
                  VerticalAlignment="Center" SelectionChanged="BitmapSelector_SelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <SelectableTextBlock x:Name="BitmapInfoText" FontSize="12"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ShowMetaButton" Content="Show Meta" Padding="12,4"
                Click="ShowMeta_Click" />
        <Button x:Name="ExtractPngButton" Content="Extract PNG" Padding="12,4"
                IsVisible="False" Click="ExtractPng_Click" />
        <Button x:Name="ExtractDdsButton" Content="Extract DDS" Padding="12,4"
                IsVisible="False" Click="ExtractDds_Click" />
        <Button x:Name="InjectDdsButton" Content="Inject DDS" Padding="12,4"
                IsVisible="False" Click="InjectDds_Click" />
      </StackPanel>
    </Border>

    <!-- Status / error message (hidden by default) -->
    <Border x:Name="StatusPanel" DockPanel.Dock="Top" IsVisible="False"
            Background="#FF3A3A3A" Padding="12,8" Margin="0,0,0,2">
      <StackPanel Spacing="8">
        <SelectableTextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}"
                             TextWrapping="Wrap" />
        <Button x:Name="BrowseSharedMapButton" Content="Browse for shared map file..."
                Padding="12,4" IsVisible="False" Click="BrowseSharedMap_Click"
                HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <!-- Preview area -->
    <Border Background="#FF1A1A1A">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Image x:Name="PreviewImage" Stretch="None"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="16" />
      </ScrollViewer>
    </Border>

  </DockPanel>

</UserControl>
