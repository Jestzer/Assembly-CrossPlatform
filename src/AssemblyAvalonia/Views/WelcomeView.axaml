<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AssemblyAvalonia.Helpers"
             x:Class="AssemblyAvalonia.Views.WelcomeView">

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="8" Margin="40" MaxWidth="500">

      <!-- Title -->
      <TextBlock Text="Assembly Crossplatform" FontSize="28" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="Cross-platform Halo map editor"
                 Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                 HorizontalAlignment="Center" Margin="0,0,0,16" />

      <!-- Open button -->
      <Button Content="Open Map File" Click="OpenFile_Click"
              HorizontalAlignment="Center" Padding="24,10" FontSize="14"
              Background="{StaticResource AccentBrush}" Foreground="White" />

      <!-- Recent files section -->
      <TextBlock Text="Recent Files" FontSize="15" FontWeight="SemiBold"
                 Foreground="{StaticResource TextSecondaryBrush}" Margin="0,24,0,6" />

      <Separator Background="{StaticResource SeparatorBrush}" Margin="0,0,0,4" />

      <!-- No recent files placeholder -->
      <TextBlock x:Name="NoRecentsText" Text="(No recent files)"
                 Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                 IsVisible="False" Margin="4,4,0,0" />

      <!-- Recent files list -->
      <ItemsControl x:Name="RecentList">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="helpers:RecentFileEntry">
            <Button Click="RecentFile_Click" Tag="{Binding FilePath}"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="8,6" Cursor="Hand">
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                  <TextBlock Text="{Binding FileGame}" Foreground="{StaticResource AccentBrushSecondary}" FontSize="12"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
