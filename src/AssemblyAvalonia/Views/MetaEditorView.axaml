<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AssemblyAvalonia.Views.MetaEditorView">

  <DockPanel>

    <!-- Tag header -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}"
            Padding="8" Margin="0,0,0,2">
      <TextBlock x:Name="TagHeader" FontSize="14" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- Plugin info -->
    <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBackgroundBrush}"
            Padding="8,4" Margin="0,0,0,4">
      <TextBlock x:Name="PluginInfo" FontSize="11"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </Border>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,2">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="SaveButton" Content="Save" Click="Save_Click"
                IsVisible="False" Padding="12,4" />
        <Button x:Name="PokeButton" Content="Poke" Click="Poke_Click"
                IsVisible="False" Padding="12,4" />
        <Button x:Name="RefreshMemButton" Content="Refresh from Memory" Click="RefreshFromMemory_Click"
                IsVisible="False" Padding="12,4" />
        <TextBox x:Name="SearchBox" Watermark="Search fields..." Width="200"
                 Padding="4,2" TextChanged="SearchBox_TextChanged" />
        <ToggleButton x:Name="HexToggle" Content="Hex" Padding="12,4"
                      IsVisible="False" Click="HexToggle_Click" />
      </StackPanel>
    </Border>

    <!-- Hex viewer (hidden by default) -->
    <ScrollViewer x:Name="HexScroller" IsVisible="False"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <TextBox x:Name="HexDisplay" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
               FontSize="12" Background="Transparent" BorderThickness="0" Padding="8"
               TextWrapping="NoWrap" AcceptsReturn="True" />
    </ScrollViewer>

    <!-- Scrollable field list -->
    <ScrollViewer x:Name="FieldScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="FieldList" Margin="4" />
    </ScrollViewer>
  </DockPanel>

</UserControl>
